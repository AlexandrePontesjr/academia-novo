# Copie para .env (que fica fora do git) e ajuste. Valores abaixo servem só para desenvolvimento local.

# Postgres da stack (docker compose)
POSTGRES_USER=academia
POSTGRES_PASSWORD=academia
POSTGRES_DB=academia
# porta do Postgres publicada na máquina
POSTGRES_PORT=5432

# API
# Fora do compose (pnpm db:migrate, API rodando na máquina). Dentro do compose, a URL é montada
# a partir das variáveis POSTGRES_* e aponta para o serviço `postgres`.
DATABASE_URL=postgres://academia:academia@localhost:5432/academia
# porta em que a API escuta, e em que o compose a publica na máquina
PORT=3001
# Chave que assina os cookies de sessão e cifra os segredos do 2FA: 32 caracteres ou mais.
# Em produção, gere uma própria (por exemplo `openssl rand -base64 32`) e nunca a troque depois.
AUTH_SECRET=apenas-desenvolvimento-troque-esta-chave
# Origem do web, a única de onde o navegador fala com a API. Tem de ser a URL que aparece na barra
# de endereço: escritas vindas de outra origem são recusadas.
WEB_ORIGIN=http://localhost:3000
# Chave das colunas cifradas em nível de aplicação (observações de saúde): o base64 de 32 bytes.
# Gere uma com `openssl rand -base64 32`. Em produção, guarde uma cópia fora do servidor e nunca
# a troque sem recifrar: sem ela toda observação de saúde já gravada fica ilegível.
DATA_ENCRYPTION_KEY=4+VCHG9Dceknevzp0tn7s9pfVt9X7Ws417FkLEPj4l8=
# Armazenamento de objetos compatível com S3 (RustFS na stack), onde ficam as fotos. Só a API o alcança.
# porta do armazenamento publicada na máquina (só em 127.0.0.1); dentro do compose o endpoint é http://storage:9000
STORAGE_PORT=9000
# Fora do compose, aponte para o armazenamento que você subiu; dentro dele, o endpoint é o serviço `storage`.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=photos
S3_ACCESS_KEY_ID=academia-storage
S3_SECRET_ACCESS_KEY=apenas-desenvolvimento-troque-esta-chave
# Chave que assina as URLs de foto, de 32 caracteres ou mais e diferente de AUTH_SECRET.
# Gere uma com `openssl rand -base64 32`. Em produção, guarde uma cópia fora do servidor: trocá-la
# invalida as URLs já emitidas (valem 5 minutos), mas não apaga nenhuma foto.
PHOTO_URL_SECRET=apenas-desenvolvimento-troque-esta-chave-das-fotos

# Web
# URL da API vista pelo servidor do web. Dentro do compose é fixada em http://api:3001.
API_URL=http://localhost:3001
# porta do web publicada na máquina
WEB_PORT=3000

# Produção (a homologação na VPS: compose.prod.yaml mais deploy/)
# endereço público que o caddy serve; a homologação local usa localhost e a CA interna do caddy
SITE_ADDRESS=localhost
# e-mail do dono do certificado, enviado ao ACME na VPS (o go-live troca o domínio e o e-mail)
ACME_EMAIL=operacao@exemplo.invalid
# webhook que recebe os alertas do Alertmanager (ntfy, Telegram, Slack ou um sink local)
ALERT_WEBHOOK_URL=http://localhost:9095/alert
# diretório do host, fora dos volumes do Docker, onde os backups diários caem
BACKUP_DIR=/var/backups/academia
# quantos dias de backup o host guarda (a retenção da door 5)
BACKUP_RETENTION_DAYS=30
# portas publicadas pelo caddy no host (80 e 443 na VPS; portas livres no desenvolvimento)
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
