    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "^1.7.7",
    "busboy": "^1.6.0",
    "drizzle-orm": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "catalog:"
